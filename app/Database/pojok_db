    jenis_shift character varying(10) NOT NULL,
    tanggal date NOT NULL,
    waktu_buka timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    waktu_tutup timestamp with time zone,
    dibuka_oleh_id bigint NOT NULL,
    ditutup_oleh_id bigint,
    status character varying(15) DEFAULT 'AKTIF'::character varying NOT NULL,
    waktu_dibuat timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    waktu_diperbarui timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT chk_shift_jenis CHECK (((jenis_shift)::text = ANY ((ARRAY['PAGI'::character varying, 'SORE'::character varying])::text[]))),
    CONSTRAINT chk_shift_konsistensi_tutup CHECK (((((status)::text = 'AKTIF'::text) AND (waktu_tutup IS NULL) AND (ditutup_oleh_id IS NULL)) OR (((status)::text = 'TERTUTUP'::text) AND (waktu_tutup IS NOT NULL) AND (ditutup_oleh_id IS NOT NULL) AND (waktu_tutup >= waktu_buka)))),
    CONSTRAINT chk_shift_status CHECK (((status)::text = ANY ((ARRAY['AKTIF'::character varying, 'TERTUTUP'::character varying])::text[])))
);


