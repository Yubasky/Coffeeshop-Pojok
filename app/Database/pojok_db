CREATE VIEW public.v_ringkasan_shift AS
 SELECT s.shift_id,
    s.jenis_shift,
    s.tanggal,
    s.status,
    s.waktu_buka,
    s.waktu_tutup,
    s.dibuka_oleh_id,
    u_buka.nama AS nama_kasir_pembuka,
    s.ditutup_oleh_id,
    u_tutup.nama AS nama_kasir_penutup,
    count(p.pesanan_id) FILTER (WHERE (((p.status_pembayaran)::text = 'LUNAS'::text) AND ((p.status_pesanan)::text <> 'DIBATALKAN'::text))) AS jumlah_transaksi_lunas,
    count(p.pesanan_id) FILTER (WHERE (((p.status_pembayaran)::text = 'LUNAS'::text) AND ((p.status_pesanan)::text <> 'DIBATALKAN'::text) AND ((pb.metode)::text = 'TUNAI'::text))) AS jumlah_transaksi_tunai,
    count(p.pesanan_id) FILTER (WHERE (((p.status_pembayaran)::text = 'LUNAS'::text) AND ((p.status_pesanan)::text <> 'DIBATALKAN'::text) AND ((pb.metode)::text = 'QRIS'::text))) AS jumlah_transaksi_qris,
    COALESCE(sum(pb.jumlah_dibayar) FILTER (WHERE (((p.status_pembayaran)::text = 'LUNAS'::text) AND ((p.status_pesanan)::text <> 'DIBATALKAN'::text) AND ((pb.metode)::text = 'TUNAI'::text))), (0)::bigint) AS total_tunai,
    COALESCE(sum(pb.jumlah_dibayar) FILTER (WHERE (((p.status_pembayaran)::text = 'LUNAS'::text) AND ((p.status_pesanan)::text <> 'DIBATALKAN'::text) AND ((pb.metode)::text = 'QRIS'::text))), (0)::bigint) AS total_qris,
    COALESCE(sum(pb.jumlah_dibayar) FILTER (WHERE (((p.status_pembayaran)::text = 'LUNAS'::text) AND ((p.status_pesanan)::text <> 'DIBATALKAN'::text))), (0)::bigint) AS total_penjualan,
    count(p.pesanan_id) FILTER (WHERE (((p.status_pembayaran)::text = 'LUNAS'::text) AND ((p.status_pesanan)::text = 'DIBATALKAN'::text))) AS jumlah_dibatalkan_sudah_bayar,
    COALESCE(sum(pb.jumlah_dibayar) FILTER (WHERE (((p.status_pembayaran)::text = 'LUNAS'::text) AND ((p.status_pesanan)::text = 'DIBATALKAN'::text))), (0)::bigint) AS nominal_dibatalkan_sudah_bayar,
    count(p.pesanan_id) FILTER (WHERE (((p.status_pembayaran)::text = 'BELUM_DIBAYAR'::text) AND ((p.status_pesanan)::text = 'DIBATALKAN'::text))) AS jumlah_dibatalkan_belum_bayar,
    count(p.pesanan_id) FILTER (WHERE ((p.status_pesanan)::text = 'DIBATALKAN'::text)) AS total_pesanan_dibatalkan,
    count(p.pesanan_id) AS total_semua_pesanan
   FROM ((((public.shift s
     JOIN public.pengguna u_buka ON ((u_buka.pengguna_id = s.dibuka_oleh_id)))
     LEFT JOIN public.pengguna u_tutup ON ((u_tutup.pengguna_id = s.ditutup_oleh_id)))
     LEFT JOIN public.pesanan p ON ((p.shift_id = s.shift_id)))
     LEFT JOIN public.pembayaran pb ON ((pb.pesanan_id = p.pesanan_id)))
  GROUP BY s.shift_id, s.jenis_shift, s.tanggal, s.status, s.waktu_buka, s.waktu_tutup, s.dibuka_oleh_id, u_buka.nama, s.ditutup_oleh_id, u_tutup.nama;


